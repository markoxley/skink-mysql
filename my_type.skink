// File:    my_type.skink
// Purpose: MySQL column-type bridge. Decodes result-set values into
//          dbx_value.Value for both wire formats — the text protocol
//          (COM_QUERY rows are all lenenc strings decoded by column
//          type) and the binary protocol (COM_STMT_EXECUTE rows are a
//          0x00 header + NULL bitmap + packed binary fields).
//
//          DATE/DATETIME/TIMESTAMP decode to KIND_TIME (Unix micros)
//          via the same civil-date math as postgres; MySQL TIME is a
//          duration that can exceed 24h and stays KIND_TEXT. DECIMAL/
//          NEWDECIMAL stays KIND_TEXT for precision. The BINARY flag
//          on blob-family columns decides KIND_BLOB vs KIND_TEXT.
module my_type

import "std/str"
import "std/libc"
import "std/strconv"
import "mod/markoxley/skink-dbx/dbx_value"
import "my_pkt"

// MySQL column type codes (protocol values).
pub const T_DECIMAL      = 0
pub const T_TINY         = 1
pub const T_SHORT        = 2
pub const T_LONG         = 3
pub const T_FLOAT        = 4
pub const T_DOUBLE       = 5
pub const T_NULL         = 6
pub const T_TIMESTAMP    = 7
pub const T_LONGLONG     = 8
pub const T_INT24        = 9
pub const T_DATE         = 10
pub const T_TIME         = 11
pub const T_DATETIME     = 12
pub const T_YEAR         = 13
pub const T_VARCHAR      = 15
pub const T_BIT          = 16
pub const T_JSON         = 245
pub const T_NEWDECIMAL   = 246
pub const T_ENUM         = 247
pub const T_SET          = 248
pub const T_TINY_BLOB    = 249
pub const T_MEDIUM_BLOB  = 250
pub const T_LONG_BLOB    = 251
pub const T_BLOB         = 252
pub const T_VAR_STRING   = 253
pub const T_STRING       = 254
pub const T_GEOMETRY     = 255

// Column flag bits.
pub const FLAG_UNSIGNED = 32
pub const FLAG_BINARY   = 128

// isIntType reports whether t is an integer column type.
fn isIntType(t: int) -> bool {
    return t == T_TINY || t == T_SHORT || t == T_LONG ||
        t == T_LONGLONG || t == T_INT24 || t == T_YEAR || t == T_BIT
}

// isFloatType reports whether t is a float column type.
fn isFloatType(t: int) -> bool {
    return t == T_FLOAT || t == T_DOUBLE
}

// isTemporal reports whether t decodes as an instant (not TIME —
// a duration that can exceed 24h or go negative).
fn isTemporal(t: int) -> bool {
    return t == T_DATE || t == T_DATETIME || t == T_TIMESTAMP
}

// daysFromCivil — same algorithm as pg_type (duplicated: modules are
// independent repos).
fn daysFromCivil(y: int, m: int, d: int) -> int64 {
    yy := int64(y)
    if m <= 2 {
        yy = yy - 1
    }
    era := yy / 400
    if yy < 0 && yy % 400 != 0 {
        era = era - 1
    }
    yoe := yy - era * 400
    mm := m
    if m > 2 {
        mm = m - 3
    } else {
        mm = m + 9
    }
    doy := (153 * int64(mm) + 2) / 5 + int64(d) - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// digits reads up to n decimal digits at *pos.
fn digits(s: string, pos: *int, n: int) -> int {
    v := 0
    for i := 0; i < n; i = i + 1 {
        c := s[*pos]
        if c < 48 || c > 57 {
            break
        }
        v = v * 10 + (c - 48)
        *pos = *pos + 1
    }
    return v
}

// parseDatetimeMicros decodes "YYYY-MM-DD[ HH:MM:SS[.ffffff]]" into
// Unix microseconds (session timezone is not applied — the value is
// taken at face value).
pub fn ParseDatetimeMicros(s: string) -> (int64, bool) {
    n := str.Len(s)
    if n < 8 {
        return int64(0), false
    }
    pos := 0
    // Date-only "YYYYMMDD" is accepted too (some drivers emit it).
    if n == 8 && s[4] != 45 {
        y := digits(s, &pos, 4)
        mo := digits(s, &pos, 2)
        dy := digits(s, &pos, 2)
        return daysFromCivil(y, mo, dy) * int64(86400000000), true
    }
    y := digits(s, &pos, 6)
    if pos >= n || s[pos] != 45 { return int64(0), false }
    pos = pos + 1
    mo := digits(s, &pos, 2)
    if pos >= n || s[pos] != 45 { return int64(0), false }
    pos = pos + 1
    dy := digits(s, &pos, 2)
    if y == 0 || mo < 1 || mo > 12 || dy < 1 || dy > 31 {
        return int64(0), false
    }
    micros := daysFromCivil(y, mo, dy) * int64(86400000000)
    if pos >= n {
        return micros, true
    }
    sep := s[pos]
    if sep != 32 && sep != 84 {
        return int64(0), false
    }
    pos = pos + 1
    hh := digits(s, &pos, 2)
    if pos >= n || s[pos] != 58 { return int64(0), false }
    pos = pos + 1
    mi := digits(s, &pos, 2)
    ss := 0
    frac := int64(0)
    if pos < n && s[pos] == 58 {
        pos = pos + 1
        ss = digits(s, &pos, 2)
    }
    if pos < n && s[pos] == 46 {
        pos = pos + 1
        scale := int64(100000)
        for pos < n && scale > 0 && s[pos] >= 48 && s[pos] <= 57 {
            frac = frac + int64(s[pos] - 48) * scale
            scale = scale / 10
            pos = pos + 1
        }
        for pos < n && s[pos] >= 48 && s[pos] <= 57 {
            pos = pos + 1
        }
    }
    return micros + int64(hh * 3600 + mi * 60 + ss) * int64(1000000) + frac, true
}

// ---- text-protocol decode ------------------------------------------------

// DecodeText converts a text-protocol column payload. NULL (0xfb
// marker) is intercepted by the caller before this is reached.
pub fn DecodeText(colType: int, flags: int, data: string, n: int) -> dbx_value.Value {
    if isIntType(colType) {
        v, ok := strconv.ParseInt64(data)
        if ok {
            return dbx_value.Int(v)
        }
        return dbx_value.TextN(data, n)
    }
    if isFloatType(colType) {
        v, ok := strconv.ParseFloat(data)
        if ok {
            return dbx_value.Float(v)
        }
        return dbx_value.TextN(data, n)
    }
    if isTemporal(colType) {
        us, ok := ParseDatetimeMicros(data)
        if ok {
            return dbx_value.TimeUnixMicros(us)
        }
        return dbx_value.TextN(data, n)
    }
    if colType == T_TINY_BLOB || colType == T_MEDIUM_BLOB ||
        colType == T_LONG_BLOB || colType == T_BLOB ||
        colType == T_GEOMETRY {
        if (flags & FLAG_BINARY) != 0 {
            return dbx_value.Blob(data, n)
        }
        return dbx_value.TextN(data, n)
    }
    // decimal/char/json/enum/set and anything unknown: raw text.
    return dbx_value.TextN(data, n)
}

// ---- binary-protocol decode ------------------------------------------------

// f32ToF64 widens a 4-byte IEEE-754 float to f64 via bit math
// (memcpy gives f64 bits directly; f32 needs an explicit expand).
fn f32ToF64(bits: int64) -> float {
    sign := 1.0
    if (bits & int64(2147483648)) != int64(0) {
        sign = -1.0
    }
    exp := int((bits >> 23) & int64(255))
    man := bits & int64(8388607)
    if exp == 255 {
        if man != 0 {
            return 0.0 / 0.0 // NaN
        }
        return sign * (1.0 / 0.0) // Inf
    }
    if exp == 0 {
        // subnormal: man * 2^-149
        v := 1.0
        for i := 0; i < 149; i = i + 1 {
            v = v * 0.5
        }
        return sign * float(man) * v
    }
    // normal: (1 + man/2^23) * 2^(exp-127)
    frac := 1.0 + float(man) / 8388608.0
    e := exp - 127
    scale := 1.0
    step := 2.0
    if e < 0 {
        step = 0.5
        e = -e
    }
    for i := 0; i < e; i = i + 1 {
        scale = scale * step
    }
    return sign * frac * scale
}

// DecodeBinary reads one binary-protocol field of the given column
// type/flags starting at *pos inside row. Unsigned columns produce
// positive int64 values where representable.
pub fn DecodeBinary(colType: int, flags: int, r: *my_pkt.Reader) -> dbx_value.Value {
    row := r.Body
    rowLen := r.Len
    pos := &r.Pos
    if *pos >= rowLen {
        return dbx_value.Null()
    }
    if colType == T_TINY {
        v := int64(row[*pos])
        if *pos < rowLen {
            *pos = *pos + 1
        }
        if (flags & FLAG_UNSIGNED) == 0 && v >= int64(128) {
            v = v - int64(256)
        }
        return dbx_value.Int(v)
    }
    if colType == T_SHORT || colType == T_YEAR {
        if *pos + 2 > rowLen { return dbx_value.Null() }
        v := int64(row[*pos]) | (int64(row[*pos + 1]) << 8)
        *pos = *pos + 2
        if (flags & FLAG_UNSIGNED) == 0 && v >= int64(32768) {
            v = v - int64(65536)
        }
        return dbx_value.Int(v)
    }
    if colType == T_LONG || colType == T_INT24 {
        if *pos + 4 > rowLen { return dbx_value.Null() }
        v := int64(row[*pos]) | (int64(row[*pos + 1]) << 8) |
            (int64(row[*pos + 2]) << 16) | (int64(row[*pos + 3]) << 24)
        *pos = *pos + 4
        if (flags & FLAG_UNSIGNED) == 0 && v >= int64(2147483648) {
            v = v - int64(4294967296)
        }
        return dbx_value.Int(v)
    }
    if colType == T_LONGLONG {
        if *pos + 8 > rowLen { return dbx_value.Null() }
        v := int64(0)
        for i := 0; i < 8; i = i + 1 {
            v = v | (int64(row[*pos + i]) << (i * 8))
        }
        *pos = *pos + 8
        return dbx_value.Int(v)
    }
    if colType == T_FLOAT {
        if *pos + 4 > rowLen { return dbx_value.Null() }
        bits := int64(row[*pos]) | (int64(row[*pos + 1]) << 8) |
            (int64(row[*pos + 2]) << 16) | (int64(row[*pos + 3]) << 24)
        *pos = *pos + 4
        return dbx_value.Float(f32ToF64(bits))
    }
    if colType == T_DOUBLE {
        if *pos + 8 > rowLen { return dbx_value.Null() }
        var f float
        libc.memcpy(&f, string(int64(row) + int64(*pos)), 8)
        *pos = *pos + 8
        return dbx_value.Float(f)
    }
    if isTemporal(colType) || colType == T_TIME {
        // Binary temporal: len byte, then [year2, month, day, hh, mm,
        // ss, micros4] depending on width. TIME instead carries
        // [neg, days4, hh, mm, ss, micros4] — a duration, rendered as
        // "[-]H+:MM:SS.ffffff" text.
        ln := int(row[*pos])
        *pos = *pos + 1
        if ln == 0 || *pos + ln > rowLen {
            if colType == T_TIME && ln == 0 {
                return dbx_value.Text("00:00:00")
            }
            return dbx_value.Text("")
        }
        if colType == T_TIME {
            neg := false
            days := int64(0)
            hh := 0
            mi := 0
            ss := 0
            frac := int64(0)
            if ln >= 8 {
                neg = row[*pos] != 0
                days = int64(row[*pos + 1]) | (int64(row[*pos + 2]) << 8) |
                    (int64(row[*pos + 3]) << 16) | (int64(row[*pos + 4]) << 24)
                hh = int(row[*pos + 5])
                mi = int(row[*pos + 6])
                ss = int(row[*pos + 7])
            }
            if ln >= 12 {
                for i := 0; i < 4; i = i + 1 {
                    frac = frac | (int64(row[*pos + 8 + i]) << (i * 8))
                }
            }
            *pos = *pos + ln
            sign := ""
            if neg {
                sign = "-"
            }
            txt := str.Concat(sign, formatDurTime(days, hh, mi, ss, frac))
            return dbx_value.Text(txt)
        }
        y := 0
        mo := 0
        dy := 0
        hh := 0
        mi := 0
        ss := 0
        frac := int64(0)
        if ln >= 4 {
            y = int(row[*pos]) | (int(row[*pos + 1]) << 8)
            mo = int(row[*pos + 2])
            dy = int(row[*pos + 3])
        }
        if ln >= 7 {
            hh = int(row[*pos + 4])
            mi = int(row[*pos + 5])
            ss = int(row[*pos + 6])
        }
        if ln >= 11 {
            for i := 0; i < 4; i = i + 1 {
                frac = frac | (int64(row[*pos + 7 + i]) << (i * 8))
            }
        }
        *pos = *pos + ln
        micros := daysFromCivil(y, mo, dy) * int64(86400000000)
        micros = micros + int64(hh * 3600 + mi * 60 + ss) * int64(1000000) + frac
        return dbx_value.TimeUnixMicros(micros)
    }
    // Everything else: length-encoded string.
    s, n, isNull := my_pkt.RLenencStr(r)
    if isNull {
        return dbx_value.Null()
    }
    if colType == T_DECIMAL || colType == T_NEWDECIMAL ||
        colType == T_JSON || colType == T_ENUM || colType == T_SET {
        return dbx_value.TextN(s, n)
    }
    if (colType == T_TINY_BLOB || colType == T_MEDIUM_BLOB ||
        colType == T_LONG_BLOB || colType == T_BLOB ||
        colType == T_GEOMETRY) && (flags & FLAG_BINARY) != 0 {
        return dbx_value.Blob(s, n)
    }
    return dbx_value.TextN(s, n)
}

// ---- parameter encoding ---------------------------------------------------

// hexDigits for blob escaping.
const hexDigits = "0123456789abcdef"

// EncodeLiteral renders a Value as an SQL literal for text-protocol
// interpolation (only used when prepared statements are unavailable).
// Always returns a fully-quoted/escaped literal — ' for strings.
pub fn EncodeLiteral(v: dbx_value.Value) -> string {
    if dbx_value.IsNull(v) {
        return "NULL"
    }
    if v.Kind == dbx_value.KIND_INT {
        return strconv.Itoa64(v.I64)
    }
    if v.Kind == dbx_value.KIND_FLOAT {
        return strconv.FormatFloat(v.F64, 17)
    }
    if v.Kind == dbx_value.KIND_BOOL {
        if v.Bool {
            return "1"
        }
        return "0"
    }
    if v.Kind == dbx_value.KIND_BLOB {
        // X'<hex>' is the SQL-standard hex literal — always read as
        // binary, unlike bare 0x<hex> which is numeric in some contexts.
        src := dbx_value.Bytes(v)
        out := libc.malloc(v.Len * 2 + 4)
        out[0] = 88  // 'X'
        out[1] = 39  // '\''
        for i := 0; i < v.Len; i = i + 1 {
            c := src[i]
            out[2 + i * 2] = hexDigits[c >> 4]
            out[3 + i * 2] = hexDigits[c & 15]
        }
        out[v.Len * 2 + 2] = 39 // '\''
        out[v.Len * 2 + 3] = 0
        return out
    }
    if v.Kind == dbx_value.KIND_TIME {
        return str.Concat("'", str.Concat(FormatTimeMicros(v.I64), "'"))
    }
    // Text/Time: quote and escape (' \ " \n \r NUL \Z).
    src := dbx_value.Bytes(v)
    n := str.Len(src)
    out := libc.malloc(n * 2 + 3)
    j := 0
    out[j] = 39 // '
    j = j + 1
    for i := 0; i < n; i = i + 1 {
        c := src[i]
        if c == 39 || c == 92 || c == 34 || c == 0 || c == 10 || c == 13 || c == 26 {
            out[j] = 92
            j = j + 1
            if c == 0 {
                out[j] = 48 // '0'
            } else if c == 10 {
                out[j] = 110 // 'n'
            } else if c == 13 {
                out[j] = 114 // 'r'
            } else if c == 26 {
                out[j] = 90 // 'Z'
            } else {
                out[j] = c
            }
        } else {
            out[j] = c
        }
        j = j + 1
    }
    out[j] = 39
    j = j + 1
    out[j] = 0
    return out
}

// ---- temporal formatting ---------------------------------------------------

// pad2/pad4/pad6 zero-pad integers for datetime literals.
fn pad2(v: int) -> string {
    if v < 10 {
        return str.Concat("0", strconv.Itoa64(int64(v)))
    }
    return strconv.Itoa64(int64(v))
}

fn pad4(v: int) -> string {
    s := strconv.Itoa64(int64(v))
    for str.Len(s) < 4 {
        s = str.Concat("0", s)
    }
    return s
}

fn pad6(v: int) -> string {
    s := strconv.Itoa64(int64(v))
    for str.Len(s) < 6 {
        s = str.Concat("0", s)
    }
    return s
}

// civilFromDays inverts daysFromCivil (Hinnant's algorithm).
fn civilFromDays(z: int64) -> (int, int, int) {
    zz := z + int64(719468)
    era := zz / int64(146097)
    if zz < 0 && zz % int64(146097) != 0 {
        era = era - 1
    }
    doe := zz - era * int64(146097)
    yoe := (doe - doe / int64(1460) + doe / int64(36524) - doe / int64(146096)) / int64(365)
    y := yoe + era * int64(400)
    doy := doe - (int64(365) * yoe + yoe / int64(4) - yoe / int64(100))
    mp := (int64(5) * doy + int64(2)) / int64(153)
    d := doy - (int64(153) * mp + int64(2)) / int64(5) + int64(1)
    m := mp + int64(3)
    if mp >= int64(10) {
        m = mp - int64(9)
    }
    if m <= int64(2) {
        y = y + 1
    }
    return int(y), int(m), int(d)
}

// formatDurTime renders a binary-protocol TIME (days + h:m:s.µs) as
// "H+:MM:SS.ffffff" — the hours field is unbounded because MySQL TIME
// is a duration, not a time-of-day.
fn formatDurTime(days: int64, hh: int, mi: int, ss: int, frac: int64) -> string {
    h := days * int64(24) + int64(hh)
    base := str.Concat(strconv.Itoa64(h), str.Concat(":",
        str.Concat(pad2(mi), str.Concat(":", pad2(ss)))))
    if frac != int64(0) {
        return str.Concat(base, str.Concat(".", pad6(int(frac))))
    }
    return base
}

// FormatTimeMicros renders Unix microseconds as
// "YYYY-MM-DD HH:MM:SS.ffffff" for datetime parameter binding.
pub fn FormatTimeMicros(us: int64) -> string {
    days := us / int64(86400000000)
    rem := us % int64(86400000000)
    if rem < 0 {
        rem = rem + int64(86400000000)
        days = days - 1
    }
    y, mo, dy := civilFromDays(days)
    secs := rem / int64(1000000)
    frac := rem % int64(1000000)
    date := str.Concat(pad4(y), str.Concat("-", str.Concat(pad2(mo),
        str.Concat("-", pad2(dy)))))
    tm := str.Concat(pad2(int(secs / 3600)), str.Concat(":",
        str.Concat(pad2(int((secs % 3600) / 60)), str.Concat(":",
        pad2(int(secs % 60))))))
    return str.Concat(date, str.Concat(" ", str.Concat(tm,
        str.Concat(".", pad6(int(frac))))))
}

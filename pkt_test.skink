// File:    pkt_test.skink
// Purpose: Unit tests for my_pkt — little-endian scalar codecs, the
//          length-encoded integer/string formats, and the packet
//          cursor. Guards exact byte layout.
module pkt_test

import "my_pkt"
import "std/str"
import "std/libc"
import "std/testing"

// TestScalars verifies little-endian encoding.
pub fn TestScalars() {
    b := my_pkt.NewOutBuf(16)
    my_pkt.I16(&b, 0x1234)
    my_pkt.I32(&b, int64(0x01020304))
    my_pkt.I64(&b, int64(0x0102030405060708))
    my_pkt.Byte(&b, 65)
    data, n := my_pkt.Data(&b)
    testing.AssertEqualInt(15, n, "len")
    testing.AssertEqualInt(0x34, data[0], "i16 lo")
    testing.AssertEqualInt(0x12, data[1], "i16 hi")
    testing.AssertEqualInt(4, data[2], "i32 b0")
    testing.AssertEqualInt(1, data[5], "i32 b3")
    testing.AssertEqualInt(8, data[6], "i64 b0")
    testing.AssertEqualInt(1, data[13], "i64 b7")
    testing.AssertEqualInt(65, data[14], "byte")
    my_pkt.Free(&b)
}

// TestLenenc covers all four lenenc widths round-tripping.
pub fn TestLenenc() {
    b := my_pkt.NewOutBuf(32)
    my_pkt.LenencInt(&b, int64(200))       // 1 byte
    my_pkt.LenencInt(&b, int64(300))       // 0xfc + 2
    my_pkt.LenencInt(&b, int64(70000))     // 0xfd + 3
    my_pkt.LenencInt(&b, int64(4294967296)) // 0xfe + 8
    data, n := my_pkt.Data(&b)
    testing.AssertEqualInt(1 + 3 + 4 + 9, n, "encoded len")

    r := my_pkt.NewReader(data, n)
    v, null1 := my_pkt.RLenenc(&r)
    testing.AssertTrue(v == int64(200) && !null1, "1-byte")
    v, null1 = my_pkt.RLenenc(&r)
    testing.AssertTrue(v == int64(300) && !null1, "0xfc 2-byte")
    v, null1 = my_pkt.RLenenc(&r)
    testing.AssertTrue(v == int64(70000) && !null1, "0xfd 3-byte")
    v, null1 = my_pkt.RLenenc(&r)
    testing.AssertTrue(v == int64(4294967296) && !null1, "0xfe 8-byte")
    testing.AssertEqualInt(0, my_pkt.Remaining(&r), "consumed")
    my_pkt.Free(&b)
}

// TestLenencNull verifies the 0xfb NULL marker.
pub fn TestLenencNull() {
    b := my_pkt.NewOutBuf(4)
    my_pkt.Byte(&b, 251)
    data, n := my_pkt.Data(&b)
    r := my_pkt.NewReader(data, n)
    _, isNull := my_pkt.RLenenc(&r)
    testing.AssertTrue(isNull, "0xfb is null")
    my_pkt.Free(&b)
}

// TestLenencStr covers length-prefixed strings with NUL interiors.
pub fn TestLenencStr() {
    b := my_pkt.NewOutBuf(16)
    raw := libc.malloc(4)
    raw[0] = 97
    raw[1] = 0
    raw[2] = 98
    raw[3] = 0
    my_pkt.LenencStr(&b, raw, 3)
    data, n := my_pkt.Data(&b)
    testing.AssertEqualInt(4, n, "encoded")

    r := my_pkt.NewReader(data, n)
    s, sn, isNull := my_pkt.RLenencStr(&r)
    testing.AssertFalse(isNull, "not null")
    testing.AssertEqualInt(3, sn, "len")
    testing.AssertEqualInt(97, s[0], "a")
    testing.AssertEqualInt(0, s[1], "NUL preserved")
    testing.AssertEqualInt(98, s[2], "b")
    my_pkt.Free(&b)
}

// TestReaderPrimitives covers the little-endian readers.
pub fn TestReaderPrimitives() {
    b := my_pkt.NewOutBuf(16)
    my_pkt.CStr(&b, "abc")
    my_pkt.I16(&b, 513)
    my_pkt.I32(&b, int64(70000))
    my_pkt.WriteN(&b, "tail", 4)
    data, n := my_pkt.Data(&b)
    r := my_pkt.NewReader(data, n)
    testing.AssertEqualString("abc", my_pkt.RCStr(&r), "cstr")
    testing.AssertEqualInt(513, my_pkt.RI16(&r), "i16")
    testing.AssertTrue(my_pkt.RI32(&r) == int64(70000), "i32")
    s, sn := my_pkt.RRest(&r)
    testing.AssertEqualInt(4, sn, "rest len")
    testing.AssertEqualString("tail", s, "rest")
    my_pkt.Free(&b)
}
